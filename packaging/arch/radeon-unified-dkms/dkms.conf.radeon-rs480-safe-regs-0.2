PACKAGE_NAME="radeon-rs480-safe-regs"
PACKAGE_VERSION="0.2"
radeon_kernel_build_root=${R300_RS480_KERNEL_BUILD_ROOT:-/lib/modules/${kernelver}/build}
printf -v radeon_kernel_build_root_q '%q' "$radeon_kernel_build_root"
radeon_dkms_build_root="${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build"
printf -v radeon_dkms_helper_q '%q' \
    "${radeon_dkms_build_root}/radeon-dkms-make"
if grep -q 'clang' \
        "$radeon_kernel_build_root/include/generated/compile.h" 2>/dev/null; then
    radeon_dkms_compiler="${radeon_dkms_build_root}/radeon-dkms-ccache-clang"
else
    radeon_dkms_compiler="${radeon_dkms_build_root}/radeon-dkms-ccache-gcc"
fi
printf -v radeon_dkms_compiler_q '%q' "$radeon_dkms_compiler"
printf -v radeon_dkms_module_q '%q' "${radeon_dkms_build_root}/radeon"
printf -v radeon_kernel_release_q '%q' "$kernelver"
radeon_parallel_arg=
if [ "${parallel_jobs+x}" = x ]; then
    case $parallel_jobs in
        '')
            radeon_parallel_arg=-j
            ;;
        *[!0-9]*)
            printf 'dkms.conf: invalid DKMS parallel job count: %s\n' \
                "$parallel_jobs" >&2
            return 1
            ;;
        *)
            radeon_parallel_arg="-j${parallel_jobs}"
            ;;
    esac
fi

# This DKMS package rebuilds the in-tree radeon driver with one
# steinmarder patch applied:
#   0001 -- rs480_safe_regs debugfs reader
#
# The patch adds a read-only seq_file that emits a curated list of BAR0
# MMIO register values for the RS400/RS480 chip family (RS482 1002:5974,
# RS485 1002:5975).
#
# Verified path on 6.18.32-1-cachyos-lts: /sys/kernel/debug/radeon_rs480_safe_regs
# (at the debugfs root, NOT under dri/0/).  The implementation uses
# rdev_to_drm(rdev)->primary->debugfs_root, which is NULL at rs400_init()
# time on this kernel; debugfs_create_file() places the file at the
# debugfs root.  On kernels where debugfs_root is non-NULL at rs400_init(),
# the file appears at /sys/kernel/debug/dri/0/radeon_rs480_safe_regs.
#
# Register list is in SAFE_REGS.tsv (same directory as dkms.conf).
# Source: rs400.c (handles both rs400 and rs480 in upstream radeon DRM).
#
# Build flow per kernel:
#   The Arch package installs the full pre-patched radeon source tree at
#   /usr/src/radeon-rs480-safe-regs-${PACKAGE_VERSION}/radeon/.  DKMS copies
#   that tree into ${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build/ for
#   each kernel.  PRE_BUILD stages radeon_trace.h only when kernel headers do
#   not ship drivers/gpu/drm/radeon/radeon_trace.h; MAKE then builds the copied
#   radeon/ directory directly.
#
# Compiler selection (CC):
#   Detected at DKMS build time by reading compile.h from the target kernel.
#   If compile.h records a clang build, CC=clang (system default Clang).
#   Otherwise, CC=gcc (system default GCC), which matches GCC-built kernels.
#   radeon-dkms-make preserves trusted non-conflicting root KCFLAGS, rejects
#   duplicate policy flags and other -O* tokens, adds the missing -O2 and -pipe
#   release flags, and keeps userspace CFLAGS outside the kernel build.
#   The CachyOS LTS kernel (6.18.x) is GCC-built; the main kernel is Clang-built.
#   Package-local wrapper scripts use ccache when available, then fall back
#   to the raw compiler.  Distcc/pump is deliberately not used here because
#   DKMS module builds consume generated kernel headers and per-kernel ABI
#   state; distributed preprocessing is better reserved for Mesa/userland.
#   To override: edit MAKE[0] or set up the wrapper scripts before triggering
#   a build.
#
# Target hardware: Vostro 1000 RS482/RS485 IGP (1002:5974 / 1002:5975)
# Tested kernels:  6.18.32-1-cachyos-lts and 7.0.9-1-cachyos on cachyos-vostro1000

BUILT_MODULE_NAME[0]="radeon"
BUILT_MODULE_LOCATION[0]="radeon"
DEST_MODULE_LOCATION[0]="/updates/dkms"

# CC detection: read compile.h from the target kernel's build headers.
# grep exit code 0 = clang built; non-zero = GCC built -> use gcc.
MAKE[0]="${radeon_dkms_helper_q}${radeon_parallel_arg:+ ${radeon_parallel_arg}} KERNELRELEASE=${radeon_kernel_release_q} CC=${radeon_dkms_compiler_q} -C ${radeon_kernel_build_root_q} M=${radeon_dkms_module_q} modules"

PRE_BUILD="pre-build.sh ${kernelver} ${radeon_kernel_build_root_q}"

AUTOINSTALL="yes"
