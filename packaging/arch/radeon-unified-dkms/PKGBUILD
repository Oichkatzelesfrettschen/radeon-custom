# Maintainer: Terascale Functionalists
# The transitional package exports the exact signed source-equivalent Radeon
# subtree. The source repository owns driver bytes; this repository owns DKMS
# construction, compiler policy, runtime defaults, and deployment artifacts.

pkgname=radeon-unified-dkms
pkgver=0.3
pkgrel=96
pkgdesc='Legacy-equivalent Radeon DKMS module from the signed source checkpoint'
arch=('x86_64')
url='https://github.com/Oichkatzelesfrettschen/linux-radeon-gororoba'
license=('GPL-2.0-only')
depends=('dkms')
makedepends=('git')
optdepends=('sp5100-tco-ioapic-dkms>=0.4-4: SB600 watchdog substrate for attended RS480 reset experiments'
            'rs480-reset-hazard-stack: RS480 failed-reset experiment dependencies and preflight')
provides=("radeon-unified=${pkgver}-${pkgrel}" 'radeon-rs480-safe-regs=0.2-10' 'radeon-palm-gate=1.0')
conflicts=('radeon-rs480-safe-regs-dkms' 'radeon-rs480-safe-regs-dkms-git' 'radeon-palm-gate-dkms')
replaces=('radeon-rs480-safe-regs-dkms' 'radeon-palm-gate-dkms')

_source_repository='Oichkatzelesfrettschen/linux-radeon-gororoba'
_source_commit='9079be562eebd184da9cf891fbc6a72d5ac0d9f3'
_source_tag='radeon-unified-0.3-pkgrel91-source-equivalent'
_source_tag_object='81a2510e34d1d62f5486683bcd6e240db8223b7d'
_source_driver_tree='b0f40a1970f57d00b690890120ad1ba8fd1e474c'
_source_url=${RADEON_UNIFIED_SOURCE_URL:-git+ssh://git@github.com/${_source_repository}.git}

source=(
  "radeon-source::${_source_url}#commit=${_source_commit}"
  'source-identity.toml'
  'dkms.conf'
  'pre-build.sh'
  'dkms-initramfs-refresh.sh'
  'compiler-policy.conf'
  'radeon-dkms-compiler-policy'
  'radeon-dkms-compiler'
  'radeon-dkms-make'
  'radeon-unified-mkinitcpio.conf'
  'radeon-re.conf'
  'radeon-dkms-ccache-gcc'
  'radeon-dkms-ccache-clang'
)
sha256sums=(
  'SKIP'
  '09fcf852d5ea91f625c2f5c6c918540ae64039b2c906a42a87f0edd3aabb1a3b'
  '74d7b127bff590d4802911fe72f83c7a87946c17f1421ffabb9f3ca57ef72752'
  '9dc4d60bec36c530c33440e4494b5ee52a15cf92e1305cf36d7f14fc960a3d08'
  '0096c2fe01a114793169e120a006684b8d98403a678568f8adc967948b134743'
  'ae05c9e34c4e9d5ae473683b30936aa70c088ae7c20777676772e10d83c83a3f'
  '7aeb7fff0b01696120ce182765df84b6f5edb6657d374c30efb85c4c86a4a9f2'
  '643aa779fb01de7f1d95dd6ec06f3422b940b7a1dcbdbc60e3e7246fb722d510'
  '1a0e02e8131b2b2896ffe6ae37e0fe205c15d07d267fa2ff8536f364713f0fcc'
  'b9804f15603da32c4e6254466a1b24975d7c67fbb1194c72f7b6995da005201e'
  '7833e442e230d3c92d3680786b247b7cac39e000e7908845d97d1b877d7539b1'
  '4654ac693bd3fd00da36779ed9ec5b10a61ab84fd4fef5a6addcf85a2fe988e7'
  '9a1e4041c958ae1fe12ded548cb0d334a5833c0d4a29bb20ba3e64cf8a9b381a'
