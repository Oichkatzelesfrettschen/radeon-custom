# Maintainer: Terascale Functionalists
# Why: kernel header packages do not ship a buildable radeon driver source
#      tree.  This package expands the canonical unified radeon source
#      tarball into /usr/src/radeon-unified-${pkgver}/radeon/ so DKMS hooks
#      rebuild the module automatically on kernel upgrades.
#
#      Targeted mechanisms (RS480/RS482/RS485 RE + Palm safety):
#        0001 safe-regs read-only debugfs;      0002 CP cache-drain packet;
#        0003 pre-reset crash-shim telemetry;   0004 candidate-register groups;
#        0005 firmware-read candidate regs;      0006 CP-ME RAM dump (RADDR port);
#        0007 cs-parser-init failure telemetry;  0008 CP-ME RAM inject
#          (write-verify-restore, exact-token + ARM-keyword gated, no execute);
#        0009 debugfs registration via drm_driver.debugfs_init so the RE nodes
#          land under dri/N on 6.7+ DRM instead of the debugfs top level;
#        0010 driver-only-read benign MC candidate node
#          (radeon_rs480_candidate_mc_benign_regs: MEM_TIMING_CNTL 0x0144,
#          MEM_STR_CNTL 0x0150; direct RREG32, the RS480-verifiable subset of
#          the 471-register flow vet; 0x017c MC_READ_CNTL_AB excluded as
#          PCI_GART_PAGE-aliased and IGP-unread on RS480);
#        0011 GART aperture status node
#          (radeon_rs480_candidate_gart_status_regs: GART_BASE 0x2c,
#          GART_FEATURE_ID 0x2b, GART_CACHE_CNTRL 0x2e, AGP_ADDRESS_SPACE_SIZE
#          0x38; MC-indirect controlled reads, read-only, driver-read on RS480.
#          GART_BASE and GART_FEATURE_ID also appear in the 0004 gart_mc cohort
#          at the same offsets; the duplication is intentional, one self-contained
#          view per cohort.  Readback is retained in
#          src/re/r300/results/cachyos_vostro1000_rs482_candidate_reader_mediated_read_sweep_20260613Z/validation.txt);
#        0012 UMA frame-buffer status node (radeon_rs480_uma_status: NB_TOM
#          decode, CONFIG_MEMSIZE, MC_FB_LOCATION, MC_MISC_UMA_CNTL, and the
#          driver real/visible/mc VRAM sizes; read-only, not a size setter).
#        0013 CP-ME oracle node (radeon_rs480_cp_me_oracle: armed by the
#          rs480_cp_me_oracle=0x4f524331 module param; root-only, inert when
#          disarmed).  Excluded on every RADEON_IS_IGP part: firing the
#          CSQ-toggle + ring_test live-fire on the RS480 IGP hard-locked both
#          CPU cores (the K8 northbridge has no MMIO completion timeout, RCA
#          2026-06-06-rs480-cp-me-oracle-csq-toggle-ringtest-safety-rca).  The
#          live-fire sequence is retained, commented, for a future discrete
#          Radeon where the PCIe completion timeout makes a wedged poll fail
#          cleanly.  On IGP the node prints the exclusion notice and returns.
#        0014 promote three config aperture/base registers (CONFIG_REG_1_BASE
#          0x010c, CONFIG_REG_APER_SIZE 0x0110, CONFIG_MEMSIZE_EMBEDDED 0x0114)
#          into the safe-regs list: read-only in the public register text and
#          confirmed readable through the 0004 candidate config cohort with
#          hazard_count=0; the candidate cohort is retained as the observation
#          provenance.
#        0015 attended single-step frontier probe node
#          (radeon_rs480_frontier_probe): retained as an inert exhausted-state
#          notice.  The selected CAP0/CAP1 VIP video-capture registers
#          (RADEON_CAP0_CONFIG 0x0958, CAP0_BUF_STATUS 0x0970, CAP1_CONFIG
#          0x09c8, CAP1_BUF_STATUS 0x09e0, CAP1_DWNSC_XRATIO 0x09e8) and IDCT
#          video-decode registers all read back 0x00000000 without a wedge in
#          retained attended bundles, so the generated frontier index map has no
#          residual rows and no rs480_frontier_index value performs an MMIO read.
#          Further VIP/CAP reads are handled by later gated readers, not by this
#          exhausted frontier node.
#        0016 CP_ME_RAM inject hardening: the increment-1 write handler returns
#          -EIO when the restore read-back fails (microcode left modified) and
#          -ENXIO when the write never took (ROM-backed address), instead of a
#          silent success; rejects a continued/seeked write (*ppos != 0); and
#          moves the result buffer + lock into a per-device context.
#        0017 promote the 3 RS400 secondary display-output registers
#          (RS400_FP2_2_GEN_CNTL 0x0388, RS400_TMDS2_CNTL 0x0394,
#          RS400_TMDS2_TRANSMITTER_CNTL 0x03a4) into the safe-regs list: the
#          attended frontier --arm read completed with the heartbeat advancing
#          and no wedge, and they have no documented write side-effect on read.
#        0018 read-only SCLK_CNTL PLL status node (radeon_rs480_sclk_cntl):
#          reads R_00000D_SCLK_CNTL through RREG32_PLL under the driver's clock
#          lock and decodes FORCE_IDCT/FORCE_VIP.  STATUS only, not a de-risker
#          for the gated CAP/IDCT MMIO read; no FORCE-on write knob.
#        0019 two read-only register-elucidation nodes:
#          radeon_rs480_pll_regs reads the full distinct PLL index set (PPLL
#          dividers, M_SPLL/MPLL/SPLL/MCLK feedback, VCLK/HTOTAL, clock-power,
#          TV/secondary) through RREG32_PLL and decodes the documented divider
#          and feedback fields.  Low hazard: r100_pll_rreg serializes the
#          index/data dance under pll_idx_lock and the aperture is always
#          clocked.  radeon_rs480_hazard_read takes a single first observation,
#          selected by radeon_rs480_hazard_index (default -1 disarmed), of the
#          22 read-safe name-pattern false-positives in the hazard tier (BIOS_8..15
#          and GUI scratch, SE_VPORT_*, SW_SEMAPHORE, WAIT_UNTIL) before they are
#          promoted to safe-regs.  The two genuine northbridge-stall registers
#          (CRTC8_IDX 0x03b4, BIF_SLAVE_CNTL 0x180c) and the index/data/FIFO and
#          CP/VIP/CAP registers are excluded at compile time, not listed.
#        0020 promote the 22 hazard-tier read-safe registers (BIOS_8..15_SCRATCH,
#          SW_SEMAPHORE, GUI_SCRATCH_REG0..5, WAIT_UNTIL, SE_VPORT_*) into the
#          read-only safe-regs list: each read clean on the real RS480 IGP through
#          the 0019 radeon_rs480_hazard_read node (every read returned, no wedge;
#          SE_VPORT verified against SCLK_CNTL FORCE_CP=1).  They were parked only
#          by a name-pattern regex, not a measured hazard.  radeon_rs480_hazard_read
#          is retained as the observation provenance.
#        0021 generate a dedicated rs480 CS-checker safe bitmap (reg_srcs/rs480 =
#          the r300 list plus the R400 fragment-shader US registers: US_CODE_BANK
#          0x46b8, US_CODE_EXT 0x46bc, US_ALU_EXT_ADDR_0..63 0x4ac0-0x4bbc).
#          CHIP_RS480 keeps the stock r300 bitmap unless the operator sets the
#          explicit module gate rs480_r400_us_cs=1 at load time for an attended
#          mesa R300_HB_R400_US run.  Every other family keeps the stock r300
#          bitmap.  These are plain value registers (code-bank index,
#          extended-address bits), not BO offsets, so they need no relocation
#          handling once the gate is armed.
#        Plus the Palm unsafe-reset guard and Evergreen SMX_DC_CTL0 allowlist,
#        and CachyOS 6.x/7.x API compatibility.
#
#      Tested: patch stack (0002-0020) compile-gated clean on 7.0.10-2-cachyos
#      AND 6.18.33-2-cachyos-lts (both clang/LLVM, LLVM=1 radeon.ko link + BTF).  RS480 debugfs nodes
#      node-validated on Vostro (RS480 0x1002:0x5974) under /sys/kernel/debug/dri/N/
#      after 0009 across prior pkgrels; ring/ib self-test pass, no DRM CS/fault
#      errors.  The 0015 frontier node is compiled as an exhausted-state notice;
#      selected CAP/IDCT runtime reads are captured per-register in the retained
#      frontier read bundles, not asserted by this package comment.
#      0021 status: mkregtable generates reg_srcs/rs480 -> rs480_reg_safe_bm[159]
#      clean (US bits cleared vs r300: dword 141 0xC100->0x0100, the 0x4ac0-0x4bbc
#      dwords cleared), and the rs480_set_reg_safe binder keeps the stock bitmap
#      unless rs480_r400_us_cs=1 is set at module load.  The full radeon.ko
#      compile-gate across both kernels runs at dkms build on install; an attended
#      R300_HB_R400_US test must arm both the Mesa route and the kernel CS gate.
#
#        0022 vertex-engine attended probe node (radeon_rs480_vertex_probe):
#          reads ONE VAP/PVS register selected by radeon_rs480_vertex_index per
#          open; index -1 (default) disarmed.  Attended-only; the VAP/PVS domain
#          clock-gates at rest and a read can stall the K8 northbridge.
#        0024 reader hazard-skip guard: the candidate/frontier readers skip an
#          offset that fails a precondition instead of issuing the stalling read.
#        0025 per-domain force-clock-then-read node (radeon_rs480_force_clock_read):
#          arms radeon_rs480_force_clock_index (default -1), sets the domain
#          SCLK_CNTL FORCE bit, reads the register, restores SCLK_CNTL.  Validated
#          the 48-entry VIP/CAP block wedge-free.  Confirmatory only: SCLK_CNTL is
#          BIOS-programmed 0xfffffff9, so every FORCE bit is already set.
#        0026 gate the wedge-prone candidate readers
#          (radeon_rs480_candidate_vap_regs, radeon_rs480_candidate_firmware_read_regs)
#          behind radeon_rs480_hazard_readers_armed (default 0 disarmed): disarmed,
#          they emit a safety notice and skip the MMIO read.  VAP/PVS clock-gates at
#          rest and stalls; the firmware_read cohort includes HOST_PATH_CNTL 0x0130,
#          which gates the HyperTransport host path.
#        0027 GPU-hang panic breadcrumb notifier (radeon_device.c): a panic
#          notifier writes the software-side ring/fence state, captured in the kdump
#          vmcore (ramoops is unviable on this K8: the reboot clears all DRAM).
#        0028 (A) promote the COMBIOS-4 (GRPH_BUFFER_CNTL 0x02f0,
#          GRPH2_BUFFER_CNTL 0x03f0, RS400_DMIF_MEM_CNTL1 0x0e38) into the
#          safe-regs list: firmware-touched in the COMBIOS ASIC-init census,
#          observed-responding, cs_writable=no and cs_special=no (no read side-effect),
#          in always-clocked display/MC domains.  (B) add the gated
#          radeon_rs480_candidate_vip_straggler_regs node (VID_BUFFER_CONTROL 0x0900,
#          FCP_CNTL 0x0910, TV_MASTER_CNTL 0x0800) behind rs480_hazard_readers_armed:
#          FORCE_VIP/FORCE_TV_SCLK are BIOS-set but these VIP/TV reads are untested,
#          so the node is disarmed by default and read attended under kdump.
#
#      Tested: patch stack (0002-0027) compile-gated clean at dkms build on
#      6.18.34-1-cachyos-lts and 7.0.11-1-cachyos; 0026 gating and 0027 breadcrumb
#      runtime-verified on cachyos-vostro1000.

pkgname=radeon-unified-dkms
pkgver=0.3
pkgrel=74
pkgdesc='Unified Radeon DKMS module for RS480 and Palm safety gates'
arch=('x86_64')
url='https://github.com/Oichkatzelesfrettschen/steinmarder'
license=('GPL-2.0-only')
# depends stays 'dkms' only: this package must remain buildable and loadable as a
# normal diagnostic DKMS module. Do NOT hard-depend on the SB600 watchdog or the
# calibration-pending feeder here -- that conflates "the radeon module loads"
# with "this machine is safe to run destructive RAD-05 fires", which a pacman
# dependency cannot prove (module loaded, /dev/watchdog present, fired latch
# cleared, netconsole live, feeder calibrated). The SB600 watchdog substrate is
# a loud optdepend below; the hard safety chain lives in the rad05-rs480-hazard-
# stack meta-package, gated by a runtime preflight, not by package presence.
depends=('dkms')
optdepends=('sp5100-tco-ioapic-dkms>=0.4-4: SB600 hardware watchdog substrate -- REQUIRED on cachyos-vostro1000 for RAD-05 hazardous reset campaigns (enables /dev/watchdog via the IOAPIC-page fallback); package presence does not validate the watchdog feeder, hazardous runs must still pass the runtime preflight'
            'rad05-rs480-hazard-stack: full RAD-05 hazard stack (radeon + SB600 watchdog + crash-capture) -- install this instead when running destructive reset experiments')
provides=("radeon-unified=${pkgver}-${pkgrel}" 'radeon-rs480-safe-regs=0.2-9' 'radeon-palm-gate=1.0')
conflicts=('radeon-rs480-safe-regs-dkms' 'radeon-rs480-safe-regs-dkms-git' 'radeon-palm-gate-dkms')
replaces=('radeon-rs480-safe-regs-dkms' 'radeon-palm-gate-dkms')

# The generated unified radeon source tarball is expanded by package() into the
# DKMS source directory.  Keep makepkg from unpacking it into srcdir first.
noextract=('radeon-unified-canonical-source.tar.xz')
