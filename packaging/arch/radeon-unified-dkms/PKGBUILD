prepare() {
  local actual

  actual=$(git -C "${srcdir}/radeon-source" rev-parse HEAD)
  [[ ${actual} == "${_source_commit}" ]] ||
    { printf 'source commit mismatch: %s\n' "${actual}" >&2; return 1; }
  actual=$(git -C "${srcdir}/radeon-source" rev-parse HEAD^{tree})
  [[ ${actual} == "${_source_repository_tree}" ]] ||
    { printf 'source repository tree mismatch: %s\n' "${actual}" >&2; return 1; }
  actual=$(git -C "${srcdir}/radeon-source" rev-parse \
    "${_source_commit}:drivers/gpu/drm/radeon")
  [[ ${actual} == "${_source_driver_tree}" ]] ||
    { printf 'source driver tree mismatch: %s\n' "${actual}" >&2; return 1; }
  actual=$(git -C "${srcdir}/radeon-source" rev-parse \
    "${_source_commit}:policy")
  [[ ${actual} == "${_source_feature_policy_tree}" ]] ||
    { printf 'source policy tree mismatch: %s\n' "${actual}" >&2; return 1; }
  actual=$(git -C "${srcdir}/radeon-source" show \
    "${_source_commit}:policy/build-features.toml" | sha256sum)
  actual=${actual%% *}
  [[ ${actual} == "${_source_feature_policy_sha256}" ]] ||
    { printf 'source feature policy mismatch: %s\n' "${actual}" >&2; return 1; }
  actual=$(git -C "${srcdir}/radeon-source" rev-parse \
    "refs/tags/${_equivalence_tag}^{tag}")
  [[ ${actual} == "${_equivalence_tag_object}" ]] ||
    { printf 'equivalence tag object mismatch: %s\n' "${actual}" >&2; return 1; }
  actual=$(git -C "${srcdir}/radeon-source" rev-parse \
    "refs/tags/${_equivalence_tag}^{}")
  [[ ${actual} == "${_equivalence_commit}" ]] ||
    { printf 'equivalence tag peel mismatch: %s\n' "${actual}" >&2; return 1; }
  git -C "${srcdir}/radeon-source" merge-base --is-ancestor \
    "${_equivalence_commit}" "${_source_commit}" ||
    { printf 'source commit does not descend from equivalence tag\n' >&2; return 1; }
}

_package_common() {
  local profile=$1
  local dkmsdir="${pkgdir}/usr/src/radeon-unified-${pkgver}"

  install -d "${dkmsdir}/radeon"
  git -C "${srcdir}/radeon-source" -c tar.umask=0022 archive \
    "${_source_commit}:drivers/gpu/drm/radeon" |
    bsdtar -xf - -C "${dkmsdir}/radeon"

  install -Dm644 "${srcdir}/source-identity.toml" \
    "${dkmsdir}/source-identity.toml"
  install -Dm644 "${srcdir}/dkms.conf.${profile}" "${dkmsdir}/dkms.conf"
  install -Dm644 "${srcdir}/radeon-build-profile.${profile}.toml" \
    "${dkmsdir}/radeon-build-profile.toml"
  install -Dm644 "${srcdir}/radeon-build-profile.${profile}.h" \
    "${dkmsdir}/radeon-build-profile.h"
  install -Dm755 "${srcdir}/pre-build.sh" "${dkmsdir}/pre-build.sh"
  install -Dm755 "${srcdir}/dkms-initramfs-refresh.sh" \
    "${dkmsdir}/dkms-initramfs-refresh.sh"
  install -Dm644 "${srcdir}/compiler-policy.conf" \
    "${dkmsdir}/compiler-policy.conf"
  install -Dm755 "${srcdir}/radeon-dkms-compiler-policy" \
    "${dkmsdir}/radeon-dkms-compiler-policy"
  install -Dm755 "${srcdir}/radeon-dkms-compiler" \
    "${dkmsdir}/radeon-dkms-compiler"
  install -Dm755 "${srcdir}/radeon-dkms-make" \
    "${dkmsdir}/radeon-dkms-make"
  install -Dm755 "${srcdir}/radeon-dkms-ccache-gcc" \
    "${dkmsdir}/radeon-dkms-ccache-gcc"
  install -Dm755 "${srcdir}/radeon-dkms-ccache-clang" \
    "${dkmsdir}/radeon-dkms-ccache-clang"
  install -Dm644 "${srcdir}/radeon-unified-mkinitcpio.conf" \
    "${pkgdir}/etc/mkinitcpio.conf.d/radeon-unified.conf"
  install -Dm644 "${srcdir}/radeon-re.conf" \
    "${pkgdir}/etc/modprobe.d/radeon-re.conf"
}

package_radeon-unified-dkms() {
  pkgdesc=${_prod_pkgdesc}
  provides=("${_common_provides[@]}")
  conflicts=('radeon-unified-dkms-dev' "${_legacy_conflicts[@]}")
  replaces=("${_legacy_replaces[@]}")
  optdepends=()

  _package_common prod
}

package_radeon-unified-dkms-dev() {
  pkgdesc=${_dev_pkgdesc}
  provides=("${_common_provides[@]}")
  conflicts=('radeon-unified-dkms' "${_legacy_conflicts[@]}")
  replaces=("${_legacy_replaces[@]}")
  optdepends=("${_dev_optdepends[@]}")

  _package_common dev
  install -Dm644 "${srcdir}/radeon-dev.conf" \
    "${pkgdir}/etc/modprobe.d/radeon-unified-dev.conf"
  for profile in observe-dev probe-dev mutate-dev; do
    install -Dm644 "${srcdir}/${profile}.conf" \
      "${pkgdir}/usr/share/radeon-unified/profiles/${profile}.conf"
  done
  install -Dm755 "${srcdir}/radeon-profile-dev" \
    "${pkgdir}/usr/bin/radeon-profile-dev"
}
