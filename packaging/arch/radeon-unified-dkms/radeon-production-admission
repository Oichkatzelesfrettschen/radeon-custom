#!/bin/sh
# Refuse a production radeon-unified-dkms transaction while development
# module configuration survives. A PreTransaction hook with AbortOnFail runs
# this before any package change, so the refusal lands while the host still
# runs its previous working configuration; a plain .install scriptlet cannot
# abort a pacman transaction because libalpm ignores scriptlet exit codes.
set -eu

blocked=0
override=/etc/modprobe.d/radeon-unified-profile-dev.conf
if [ -e "$override" ]; then
    printf 'radeon-unified-dkms: development profile override %s is present\n' \
        "$override" >&2
    blocked=1
fi
# A development option row blocks admission only when the transaction does
# not govern its file: rows in configuration owned by a radeon-unified
# package are replaced atomically by the same transaction that installs
# production, while unowned or foreign-owned rows survive it and would
# reject the production module at the next load.
for conf_dir in /etc/modprobe.d /usr/lib/modprobe.d; do
    [ -d "$conf_dir" ] || continue
    for conf in "$conf_dir"/*.conf; do
        [ -f "$conf" ] || continue
        case $(pacman -Qoq "$conf" 2>/dev/null || printf unowned) in
            radeon-unified-dkms | radeon-unified-dkms-dev | \
            radeon-rs482-policy)
                continue
                ;;
        esac
        rows=$(awk '
            $1 == "options" && $2 == "radeon" {
                for (i = 3; i <= NF; i++) {
                    if ($i ~ /^profile_dev=/ ||
                        $i ~ /^rs480_/ ||
                        $i ~ /^radeon_rs480_/ ||
                        $i ~ /^palm_pci_reset_unsafe=/)
                        print $i
                }
            }' "$conf" | grep -v '^profile_dev=off$' || true)
        if [ -n "$rows" ]; then
            printf 'radeon-unified-dkms: %s carries development options:\n' \
                "$conf" >&2
            printf '%s\n' "$rows" >&2
            blocked=1
        fi
    done
done
if [ "$blocked" -ne 0 ]; then
    printf 'radeon-unified-dkms: select the off profile or remove the development configuration, then retry\n' >&2
    exit 1
fi
exit 0
