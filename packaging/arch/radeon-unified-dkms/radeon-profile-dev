#!/bin/sh
# Select and attest the radeon development runtime profile.

set -eu

program=${0##*/}
source_root=/usr/src/radeon-unified-0.8.18
manifest="${source_root}/radeon-build-profile.toml"
identity="${source_root}/source-identity.toml"
profile_root=/usr/share/radeon-unified/profiles
override=/etc/modprobe.d/radeon-unified-profile-dev.conf
refresh="${source_root}/dkms-initramfs-refresh.sh"

die() {
    printf '%s: %s\n' "$program" "$*" >&2
    exit 1
}

# tomllib parses the whole document, so a duplicate key, a type mismatch, or
# malformed TOML fails the read instead of yielding the first line a scanner
# happens to match.
toml_value() {
    command -v python3 >/dev/null 2>&1 ||
        die "python3 is required for manifest parsing"
    python3 - "$1" "$2" <<'EOF' || die "manifest key $1 is absent or invalid in $2"
import sys
import tomllib

key, path = sys.argv[1], sys.argv[2]
with open(path, "rb") as handle:
    document = tomllib.load(handle)
value = document.get(key)
if not isinstance(value, str) or not value:
    sys.exit(1)
sys.stdout.write(value + "\n")
EOF
}

require_regular() {
    [ -f "$1" ] && [ ! -L "$1" ] ||
        die "required regular file is absent: $1"
}

require_dev_package() {
    command -v pacman >/dev/null 2>&1 ||
        die "pacman is required for package attestation"
    installed=$(pacman -Qq radeon-unified-dkms-dev 2>/dev/null || true)
    [ "$installed" = radeon-unified-dkms-dev ] ||
        die "radeon-unified-dkms-dev is not installed"
}

verify_manifest() {
    require_regular "$manifest"
    require_regular "$identity"
    [ "$(toml_value package_name "$manifest")" = radeon-unified-dkms-dev ] ||
        die "installed build manifest names another package"
    [ "$(toml_value build_profile "$manifest")" = all-dev ] ||
        die "development package build profile is not all-dev"
    [ "$(toml_value compiled_ceiling "$manifest")" = mutate-dev ] ||
        die "development package ceiling is not mutate-dev"
    for field in source_commit repository_tree driver_tree; do
        manifest_value=$(toml_value "$field" "$manifest")
        identity_value=$(toml_value "$field" "$identity")
        [ "$manifest_value" = "$identity_value" ] ||
            die "$field disagrees between installed manifests"
    done
    manifest_policy=$(toml_value feature_policy_sha256 "$manifest")
    identity_policy=$(toml_value feature_policy_sha256 "$identity")
    [ "$manifest_policy" = "$identity_policy" ] ||
        die "feature policy digest disagrees between installed manifests"
}

requested_profile() {
    if [ ! -e "$override" ]; then
        printf '%s\n' off
        return
    fi
    require_regular "$override"
    value=$(awk '
        $1 == "options" && $2 == "radeon" {
            for (field_index = 3; field_index <= NF; field_index++) {
                if ($field_index ~ /^profile_dev=/) {
                    sub(/^profile_dev=/, "", $field_index)
                    print $field_index
                    found = 1
                }
            }
        }
        END { if (!found) exit 1 }
    ' "$override") || die "override contains no profile_dev selection"
    case "$value" in
        observe-dev | probe-dev | mutate-dev)
            printf '%s\n' "$value"
            ;;
        *)
            die "override contains an invalid profile_dev value"
            ;;
    esac
}

# modprobe -c resolves every configuration file in modprobe's own search
# order, and the kernel takes the last occurrence of a repeated option, so
# the final profile_dev row is the value the next module load receives. The
# package default radeon-unified-dev.conf row (profile_dev=off) sorts before
# the selector override, so both legitimately coexist. Every row must still
# carry a valid value: an unknown value anywhere is foreign configuration.
effective_profile() {
    command -v modprobe >/dev/null 2>&1 ||
        die "modprobe is required for effective-configuration verification"
    rows=$(modprobe -c | awk '
        $1 == "options" && $2 == "radeon" {
            for (field_index = 3; field_index <= NF; field_index++) {
                if ($field_index ~ /^profile_dev=/) {
                    sub(/^profile_dev=/, "", $field_index)
                    print $field_index
                }
            }
        }')
    if [ -z "$rows" ]; then
        printf '%s\n' off
        return
    fi
    last=
    for row in $rows; do
        case "$row" in
            off | observe-dev | probe-dev | mutate-dev)
                last=$row
                ;;
            *)
                die "effective modprobe configuration carries an invalid profile_dev value: $row"
                ;;
        esac
    done
    printf '%s\n' "$last"
}

verify_effective_matches() {
    requested=$1
    effective=$(effective_profile)
    [ "$effective" = "$requested" ] ||
        die "effective modprobe profile is ${effective}, not the requested ${requested}"
}

acknowledge_profile() {
    profile=$1
    prompt=$2
    [ -t 0 ] ||
        die "${profile} selection requires an interactive acknowledgement"
    printf '%s: ' "$prompt" >&2
    IFS= read -r acknowledgement
    [ "$acknowledgement" = "$profile" ] ||
        die "${profile} acknowledgement did not match"
}

show_profile() {
    require_dev_package
    verify_manifest
    printf 'package=radeon-unified-dkms-dev\n'
    printf 'build_profile=%s\n' "$(toml_value build_profile "$manifest")"
    printf 'compiled_ceiling=%s\n' "$(toml_value compiled_ceiling "$manifest")"
    printf 'requested_profile=%s\n' "$(requested_profile)"
    printf 'effective_modprobe_profile=%s\n' "$(effective_profile)"
    if [ -r /sys/module/radeon/parameters/profile_dev ]; then
        printf 'loaded_profile=%s\n' \
            "$(cat /sys/module/radeon/parameters/profile_dev)"
    else
        printf 'loaded_profile=unavailable\n'
    fi
}

refresh_initramfs() {
    require_regular "$refresh"
    [ -x "$refresh" ] || die "initramfs refresh helper is not executable"
    "$refresh"
}

select_profile() {
    profile=$1
    temporary=
    backup=
    had_override=0
    [ "$(id -u)" -eq 0 ] || die "profile selection requires root"
    require_dev_package
    verify_manifest
    [ -d /etc/modprobe.d ] && [ ! -L /etc/modprobe.d ] ||
        die "/etc/modprobe.d is not a regular directory"
    if [ -L "$override" ]; then
        die "profile override is a symbolic link"
    fi
    if [ -e "$override" ] && [ ! -f "$override" ]; then
        die "profile override is not a regular file"
    fi
    # Attended acknowledgements are monotone with hazard: probe-dev confirms
    # active diagnostic reads, and mutate-dev confirms hardware mutation and
    # then passes the hazard preflight. Both run before any configuration or
    # initramfs change so a refused acknowledgement leaves the host untouched.
    case "$profile" in
        probe-dev)
            acknowledge_profile probe-dev \
                'Type probe-dev to confirm active diagnostic reads'
            ;;
        mutate-dev)
            acknowledge_profile mutate-dev \
                'Type mutate-dev to confirm hardware-mutating interfaces'
            command -v rs480-reset-hazard-preflight >/dev/null 2>&1 ||
                die "mutate-dev requires rs480-reset-hazard-preflight"
            rs480-reset-hazard-preflight
            ;;
        off | observe-dev)
            ;;
        *)
            die "profile must be off, observe-dev, probe-dev, or mutate-dev"
            ;;
    esac
    if [ -f "$override" ]; then
        backup=$(mktemp "${override}.backup.XXXXXX")
        install -m 0644 "$override" "$backup"
        had_override=1
    fi
    trap 'rm -f -- "${temporary-}" "${backup-}"' EXIT HUP INT TERM
    case "$profile" in
        off)
            rm -f -- "$override"
            ;;
        observe-dev | probe-dev | mutate-dev)
            template="${profile_root}/${profile}.conf"
            require_regular "$template"
            temporary=$(mktemp "${override}.XXXXXX")
            install -m 0644 "$template" "$temporary"
            mv -f -- "$temporary" "$override"
            temporary=
            ;;
    esac
    restore_prior() {
        if [ "$had_override" -eq 1 ]; then
            mv -f -- "$backup" "$override"
            backup=
        else
            rm -f -- "$override"
        fi
    }
    # The subshells confine each verifier's exit so the rollback branch runs.
    if ! ( verify_effective_matches "$profile" ); then
        restore_prior
        die "effective configuration mismatch and the prior profile was restored"
    fi
    if ! ( refresh_initramfs ); then
        restore_prior
        ( refresh_initramfs ) >/dev/null 2>&1 || true
        die "initramfs refresh failed and the prior profile was restored"
    fi
    rm -f -- "$backup"
    backup=
    trap - EXIT HUP INT TERM
    printf '%s\n' \
        "profile_dev=${profile} will take effect after the next safe reboot"
    printf '%s\n' "the loaded module was not reloaded"
}

verify_loaded() {
    require_dev_package
    verify_manifest
    command -v modinfo >/dev/null 2>&1 ||
        die "modinfo is required for module attestation"
    expected_source=$(toml_value source_commit "$manifest")
    expected_policy=$(toml_value feature_policy_sha256 "$manifest")
    expected_upstream=$(toml_value upstream_base "$manifest")
    [ "$(modinfo -F gororoba_build_profile radeon)" = mutate-dev ] ||
        die "installed module build profile is not mutate-dev"
    [ "$(modinfo -F gororoba_source_commit radeon)" = "$expected_source" ] ||
        die "installed module source commit disagrees with the manifest"
    [ "$(modinfo -F gororoba_feature_policy_sha256 radeon)" = \
        "$expected_policy" ] ||
        die "installed module feature policy disagrees with the manifest"
    [ "$(modinfo -F gororoba_upstream_base radeon)" = "$expected_upstream" ] ||
        die "installed module upstream base disagrees with the manifest"
    installed_srcversion=$(modinfo -F srcversion radeon)
    [ -n "$installed_srcversion" ] ||
        die "installed module reports no srcversion"
    installed_vermagic=$(modinfo -F vermagic radeon)
    running_release=$(uname -r)
    case "$installed_vermagic" in
        "$running_release "*)
            ;;
        *)
            die "installed vermagic ${installed_vermagic%% *} does not match the running kernel ${running_release}"
            ;;
    esac
    printf '%s\n' "installed-attestation: PASS"
    # modinfo attests the on-disk module; /sys/module/radeon attests the
    # module the kernel actually loaded. The two diverge across an upgrade
    # without a reboot, so each attestation reports separately.
    if [ ! -d /sys/module/radeon ]; then
        printf '%s\n' "loaded-attestation: NOT RUN (no radeon module is loaded)"
        return
    fi
    [ -r /sys/module/radeon/srcversion ] ||
        die "loaded module srcversion is unreadable"
    loaded_srcversion=$(cat /sys/module/radeon/srcversion)
    [ "$loaded_srcversion" = "$installed_srcversion" ] ||
        die "loaded srcversion ${loaded_srcversion} disagrees with installed ${installed_srcversion}"
    [ -e /sys/module/radeon/parameters/profile_dev ] ||
        die "loaded development module exposes no profile_dev parameter"
    [ -r /sys/module/radeon/parameters/profile_dev ] ||
        die "loaded profile_dev is unreadable"
    loaded=$(cat /sys/module/radeon/parameters/profile_dev)
    effective=$(effective_profile)
    [ "$loaded" = "$effective" ] ||
        die "loaded profile_dev ${loaded} disagrees with the effective ${effective}"
    printf '%s\n' "loaded-attestation: PASS"
}

[ "$#" -ge 1 ] || die "command must be show, select, or verify"
command=$1
shift
case "$command" in
    show)
        [ "$#" -eq 0 ] || die "show accepts no arguments"
        show_profile
        ;;
    select)
        [ "$#" -eq 1 ] || die "select requires one profile"
        select_profile "$1"
        ;;
    verify)
        [ "$#" -eq 0 ] || die "verify accepts no arguments"
        verify_loaded
        ;;
    *)
        die "command must be show, select, or verify"
        ;;
esac
