#!/bin/sh
# Compose package release flags with root-controlled Kbuild KCFLAGS.

set -eu
set -f

kcflags=${KCFLAGS-}
o2_count=0
pipe_count=0

case "$kcflags" in
    *[!\ -~]*)
        printf '%s\n' \
            'radeon-dkms-make: KCFLAGS must contain printable ASCII separated by spaces' \
            >&2
        exit 2
        ;;
esac

for word in $kcflags; do
    case "$word" in
        *[!A-Za-z0-9_./,:+=%@~-]*)
            printf 'radeon-dkms-make: unsafe KCFLAGS token: %s\n' \
                "$word" >&2
            exit 2
            ;;
    esac
    case "$word" in
        -O2)
            o2_count=$((o2_count + 1))
            ;;
        -O*)
            printf '%s\n' \
                "radeon-dkms-make: conflicting optimization token: $word; package requires -O2" \
                >&2
            exit 2
            ;;
        -pipe)
            pipe_count=$((pipe_count + 1))
            ;;
    esac
done

if [ "$o2_count" -gt 1 ]; then
    printf '%s\n' \
        'radeon-dkms-make: duplicate package KCFLAGS token: -O2' >&2
    exit 2
fi
if [ "$pipe_count" -gt 1 ]; then
    printf '%s\n' \
        'radeon-dkms-make: duplicate package KCFLAGS token: -pipe' >&2
    exit 2
fi

[ "$o2_count" -eq 1 ] ||
    kcflags="${kcflags:+${kcflags} }-O2"
[ "$pipe_count" -eq 1 ] ||
    kcflags="${kcflags:+${kcflags} }-pipe"

KCFLAGS=$kcflags
export KCFLAGS
unset CFLAGS CPPFLAGS CXXFLAGS LDFLAGS
unset MAKEFLAGS MFLAGS GNUMAKEFLAGS MAKEFILES

if [ "${RADEON_DKMS_MAKE_TRACE:-0}" = 1 ]; then
    printf 'radeon-dkms-make: KCFLAGS=%s\n' "$KCFLAGS" >&2
fi

exec make "$@"
