#!/bin/sh
# Compose package release flags with root-controlled Kbuild KCFLAGS.

set -eu
set -f

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
trace_include="${script_dir}/.radeon-trace-include/include/trace"
profile_header="${script_dir}/radeon-build-profile.h"

encode_make_path() {
    case "$1" in
        *[!\ -~]*)
            printf '%s\n' \
                'radeon-dkms-make: package paths must contain printable ASCII' \
                >&2
            return 2
            ;;
    esac
    case "$1" in
        *\$*)
            printf '%s\n' \
                "radeon-dkms-make: package paths must not contain '\$'" \
                >&2
            return 2
            ;;
    esac
    case "$1" in
        *[!A-Za-z0-9_./:-]*)
            encoded_path=$(printf '%s\n' "$1" |
                sed "s/'/'\\\\''/g")
            printf "'%s'\n" "$encoded_path"
            ;;
        *)
            printf '%s\n' "$1"
            ;;
    esac
}

trace_include_for_make=$(encode_make_path "$trace_include")
profile_header_for_make=$(encode_make_path "$profile_header")
kcflags=${KCFLAGS-}
o2_count=0
pipe_count=0

case "$kcflags" in
    *[!\ -~]*)
        printf '%s\n' \
            'radeon-dkms-make: KCFLAGS must contain printable ASCII separated by spaces' \
            >&2
        exit 2
        ;;
esac

for word in $kcflags; do
    case "$word" in
        *[!A-Za-z0-9_./,:+=%@~-]*)
            printf 'radeon-dkms-make: unsafe KCFLAGS token: %s\n' \
                "$word" >&2
            exit 2
            ;;
    esac
    case "$word" in
        -I*/.radeon-trace-include/include/trace)
            printf '%s\n' \
                'radeon-dkms-make: caller KCFLAGS contains the reserved trace include' \
                >&2
            exit 2
            ;;
        -include | */radeon-build-profile.h)
            printf '%s\n' \
                'radeon-dkms-make: caller KCFLAGS contains the reserved build profile' \
                >&2
            exit 2
            ;;
        -O2)
            o2_count=$((o2_count + 1))
            ;;
        -O*)
            printf '%s\n' \
                "radeon-dkms-make: conflicting optimization token: $word; package requires -O2" \
                >&2
            exit 2
            ;;
        -pipe)
            pipe_count=$((pipe_count + 1))
            ;;
    esac
done

if [ "$o2_count" -gt 1 ]; then
    printf '%s\n' \
        'radeon-dkms-make: duplicate package KCFLAGS token: -O2' >&2
    exit 2
fi
if [ "$pipe_count" -gt 1 ]; then
    printf '%s\n' \
        'radeon-dkms-make: duplicate package KCFLAGS token: -pipe' >&2
    exit 2
fi

[ "$o2_count" -eq 1 ] ||
    kcflags="${kcflags:+${kcflags} }-O2"
[ "$pipe_count" -eq 1 ] ||
    kcflags="${kcflags:+${kcflags} }-pipe"
kcflags="${kcflags:+${kcflags} }-I${trace_include_for_make}"
if [ -f "$profile_header" ]; then
    kcflags="${kcflags} -include ${profile_header_for_make}"
fi

reject_reserved_assignment() {
    printf '%s\n' \
        'radeon-dkms-make: command-line package-controlled variable assignment is reserved' \
        >&2
    exit 2
}

reject_expanded_assignment_name() {
    printf '%s\n' \
        'radeon-dkms-make: command-line assignment names must not use GNU Make expansion syntax' \
        >&2
    exit 2
}

reject_expanded_assignment_value() {
    printf '%s\n' \
        'radeon-dkms-make: command-line assignment values must not use GNU Make expansion syntax' \
        >&2
    exit 2
}

reject_reserved_make_assignment() {
    argument_value=$1
    local assignment_name
    local assignment_value
    while :; do
        case "$argument_value" in
            [[:space:]]*)
                argument_value=${argument_value#?}
                ;;
            *)
                break
                ;;
        esac
    done
    # GNU Make expands variable references in assignment names and values
    # before applying the assignment, so literal-safe text can still mutate
    # package-controlled variables.
    case "$argument_value" in
        *=*)
            assignment_name=${argument_value%%=*}
            assignment_value=${argument_value#*=}
            case "$assignment_name" in
                *\$*)
                    reject_expanded_assignment_name
                    ;;
            esac
            case "$assignment_value" in
                *\$*)
                    reject_expanded_assignment_value
                    ;;
            esac
            ;;
    esac
    for reserved_variable in \
        KCFLAGS MAKEFLAGS MFLAGS GNUMAKEFLAGS MAKEOVERRIDES MAKEFILES \
        CFLAGS CPPFLAGS CXXFLAGS LDFLAGS; do
        case "$argument_value" in
            "$reserved_variable"=* | "$reserved_variable"+=* | \
                "$reserved_variable":=* | "$reserved_variable"::=* | \
                "$reserved_variable":::=* | "$reserved_variable"\?=* | \
                "$reserved_variable"!=* | \
                "$reserved_variable"[[:space:]]*=* | \
                "$reserved_variable"[[:space:]]*+=* | \
                "$reserved_variable"[[:space:]]*:=* | \
                "$reserved_variable"[[:space:]]*::=* | \
                "$reserved_variable"[[:space:]]*:::=* | \
                "$reserved_variable"[[:space:]]*\?=* | \
                "$reserved_variable"[[:space:]]*!=*)
                reject_reserved_assignment
                ;;
        esac
    done
}

reject_eval_option() {
    printf '%s\n' \
        'radeon-dkms-make: GNU Make eval options are reserved' \
        >&2
    exit 2
}

reject_makefile_option() {
    printf '%s\n' \
        'radeon-dkms-make: GNU Make makefile selector options are reserved' \
        >&2
    exit 2
}

reject_include_option() {
    printf '%s\n' \
        'radeon-dkms-make: GNU Make include-directory options are reserved' \
        >&2
    exit 2
}

inspect_short_make_options() {
    short_options=${1#-}
    while [ -n "$short_options" ]; do
        short_option=${short_options%"${short_options#?}"}
        short_options=${short_options#?}
        case "$short_option" in
            E)
                reject_eval_option
                ;;
            f)
                reject_makefile_option
                ;;
            I)
                reject_include_option
                ;;
            C | j | l | o | O | W)
                return
                ;;
        esac
    done
}

options_active=1
for argument in "$@"; do
    if [ "$options_active" -eq 0 ]; then
        reject_reserved_make_assignment "$argument"
        continue
    fi
    case "$argument" in
        --)
            options_active=0
            ;;
        --ev*)
            reject_eval_option
            ;;
        --f* | --mak*)
            reject_makefile_option
            ;;
        --in*)
            reject_include_option
            ;;
        --*)
            ;;
        -?*)
            inspect_short_make_options "$argument"
            ;;
        *)
            reject_reserved_make_assignment "$argument"
            ;;
    esac
done

KCFLAGS=$kcflags
export KCFLAGS
unset CFLAGS CPPFLAGS CXXFLAGS LDFLAGS
unset MAKEFLAGS MFLAGS GNUMAKEFLAGS MAKEFILES MAKEOVERRIDES

if [ "${RADEON_DKMS_MAKE_TRACE:-0}" = 1 ]; then
    printf 'radeon-dkms-make: KCFLAGS=%s\n' "$KCFLAGS" >&2
fi

exec make "$@"
