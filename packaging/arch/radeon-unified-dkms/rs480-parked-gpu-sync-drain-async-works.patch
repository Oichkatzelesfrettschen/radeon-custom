--- a/radeon/radeon_device.c
+++ b/radeon/radeon_device.c
@@ -2008,10 +2008,28 @@
 		 * A parked GPU releases software ownership and touches no
 		 * hardware until the reboot that reclaims it.
 		 */
-		dev_err(rdev->dev, "parked: disabling IRQ line (no MMIO) + cancelling PM/hotplug works\n");
+		dev_err(rdev->dev, "parked: disabling IRQ line (no MMIO)\n");
 		disable_irq(rdev->pdev->irq);
-		cancel_delayed_work(&rdev->pm.dynpm_idle_work);
-		cancel_delayed_work(&rdev->hotplug_work);
+		msleep(1);
+		/* cancel_delayed_work is asynchronous: a handler already past its
+		 * gpu_parked gate and mid-execution when cancelled continues into a
+		 * register read during the quiet epoch. Drain with the _sync variant
+		 * so that after this returns no handler is running or scheduled. The
+		 * fence lockup work early-returns under gpu_parked (0051) and neither
+		 * the dynamic-PM idle nor hotplug work takes exclusive_lock, so
+		 * cancel_delayed_work_sync from this write-locked context cannot
+		 * deadlock.
+		 */
+		dev_err(rdev->dev, "parked: draining fence lockup works (sync)\n");
+		for (i = 0; i < RADEON_NUM_RINGS; ++i)
+			cancel_delayed_work_sync(&rdev->fence_drv[i].lockup_work);
+		msleep(1);
+		dev_err(rdev->dev, "parked: draining dynpm idle work (sync)\n");
+		cancel_delayed_work_sync(&rdev->pm.dynpm_idle_work);
+		msleep(1);
+		dev_err(rdev->dev, "parked: draining hotplug work (sync)\n");
+		cancel_delayed_work_sync(&rdev->hotplug_work);
+		msleep(1);
 		dev_err(rdev->dev, "parked: async agents quiesced, entering quiet epoch\n");
 		rdev->in_reset = true;
 		rdev->needs_reset = false;
