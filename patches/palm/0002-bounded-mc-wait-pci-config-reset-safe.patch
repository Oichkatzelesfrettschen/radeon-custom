From: steinmarder bounded-MC-wait reset track
Subject: [PATCH 2/4] drm/radeon: evergreen: add bounded-MC-wait safe variant of pci-config reset

evergreen_gpu_pci_config_reset is void and proceeds with
radeon_pci_config_reset even when evergreen_mc_wait_for_idle returns
non-zero.  Writing the pci-config reset bits with MC mid-transaction
is the empirical PCI-bus-wedge trigger on CHIP_PALM (Wrestler GPU,
Brazos APU, Evergreen / TeraScale-2 VLIW5).

Add a sibling evergreen_gpu_pci_config_reset_safe that returns int.
Mirror the original preamble (halt CP / DMA / RLC, clk bypass,
disable bus master, evergreen_mc_stop) and refuse to issue
radeon_pci_config_reset when mc_wait_for_idle reports busy, returning
-EBUSY after evergreen_mc_resume.

Also gate the entire safe variant on CHIP_PALM: even when MC is idle
the reset propagates a transient PCIe-fabric stall to adjacent
integrated devices on Brazos (the embedded GbE controller drops for
about 2 minutes; the X session loses its dual-output layout state).
Refuse by default on Palm and require radeon.palm_pci_reset_unsafe=1
to override.

The original void variant is preserved unchanged for
evergreen_asic_reset backward compatibility.  Future callers (the
debugfs trigger added in [PATCH 3/4], future user-space recovery
scripts) use the new safe variant.

Assisted-by: Claude Opus 4.7
---
 drivers/gpu/drm/radeon/evergreen.c   | 70 ++++++++++++++++++++++++++++
 drivers/gpu/drm/radeon/radeon_asic.h |  1 +
 2 files changed, 71 insertions(+)

--- a/drivers/gpu/drm/radeon/evergreen.c
+++ b/drivers/gpu/drm/radeon/evergreen.c
@@ -4054,6 +4054,76 @@ void evergreen_gpu_pci_config_reset(struct radeon_device *rdev)
 	}
 }

+int evergreen_gpu_pci_config_reset_safe(struct radeon_device *rdev)
+{
+	struct evergreen_mc_save save;
+	u32 tmp, i;
+
+	/* CHIP_PALM (Wrestler GPU on Brazos APU, Evergreen / TeraScale-2 VLIW5)
+	 * shares the PCIe root-complex with the embedded GbE controller.
+	 * A pci-config reset propagates a brief link-training stall to
+	 * adjacent devices (the NIC goes offline for about 2 minutes on the
+	 * ThinkPad X130e and X-server loses its dual-output layout state).
+	 * Refuse by default on Palm-class silicon; userspace must set
+	 * radeon.palm_pci_reset_unsafe=1 to override.
+	 */
+	if (rdev->family == CHIP_PALM && !radeon_palm_pci_reset_unsafe) {
+		dev_warn(rdev->dev,
+			"refusing pci-config reset on CHIP_PALM: propagates to PCIe root-complex; set radeon.palm_pci_reset_unsafe=1 to override\n");
+		return -EPERM;
+	}
+
+	dev_info(rdev->dev, "GPU pci config reset (bounded MC-wait safe variant)\n");
+
+	/* Disable CP parsing/prefetching */
+	WREG32(CP_ME_CNTL, CP_ME_HALT | CP_PFP_HALT);
+	udelay(50);
+
+	/* Disable DMA */
+	tmp = RREG32(DMA_RB_CNTL);
+	tmp &= ~DMA_RB_ENABLE;
+	WREG32(DMA_RB_CNTL, tmp);
+
+	/* halt the rlc */
+	r600_rlc_stop(rdev);
+	udelay(50);
+
+	/* set mclk/sclk to bypass */
+	rv770_set_clk_bypass_mode(rdev);
+	/* disable BM */
+	pci_clear_master(rdev->pdev);
+	/* disable mem access */
+	evergreen_mc_stop(rdev, &save);
+
+	/* If MC is still busy after the bounded wait, refuse: writing the
+	 * pci-config reset bits with the MC mid-transaction is the failure
+	 * mode the safe variant exists to prevent.
+	 */
+	if (evergreen_mc_wait_for_idle(rdev)) {
+		dev_warn(rdev->dev,
+			"refusing pci-config reset: MC stuck busy after bounded wait\n");
+		evergreen_mc_resume(rdev, &save);
+		return -EBUSY;
+	}
+
+	/* reset */
+	radeon_pci_config_reset(rdev);
+
+	/* wait for asic to come out of reset */
+	for (i = 0; i < rdev->usec_timeout; i++) {
+		if (RREG32(CONFIG_MEMSIZE) != 0xffffffff)
+			break;
+		udelay(1);
+	}
+	return 0;
+}
+
 int evergreen_asic_reset(struct radeon_device *rdev, bool hard)
 {
 	u32 reset_mask;
--- a/drivers/gpu/drm/radeon/radeon_asic.h
+++ b/drivers/gpu/drm/radeon/radeon_asic.h
@@ -522,6 +522,7 @@ extern void evergreen_print_gpu_status_regs(struct radeon_device *rdev);
 extern u32 evergreen_get_number_of_dram_channels(struct radeon_device *rdev);
 extern int evergreen_asic_reset(struct radeon_device *rdev, bool hard);
 extern void evergreen_gpu_pci_config_reset(struct radeon_device *rdev);
+extern int evergreen_gpu_pci_config_reset_safe(struct radeon_device *rdev);

