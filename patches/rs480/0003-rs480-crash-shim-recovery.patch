--- a/radeon/radeon_device.c
+++ b/radeon/radeon_device.c
@@ -1778,6 +1778,16 @@ int radeon_gpu_reset(struct radeon_device *rdev)
 
 	atomic_inc(&rdev->gpu_reset_counter);
 
+	/* Log RS400/RS480 queue and cache state before GPU reset. */
+	if (rdev->family == CHIP_RS480 || rdev->family == CHIP_RS400) {
+		DRM_ERROR("=== RS482 CRASH SHIM TRIGGERED ===\n");
+		DRM_ERROR("CP_RB_RPTR: 0x%08X\n", RREG32(0x0704));
+		DRM_ERROR("CP_RB_WPTR: 0x%08X\n", RREG32(0x0714));
+		DRM_ERROR("MC_STATUS: 0x%08X\n", RREG32(0x0150));
+		DRM_ERROR("RB3D_DSTCACHE_CTLSTAT: 0x%08X\n", RREG32(0x4E4C));
+		DRM_ERROR("==================================\n");
+	}
+
 	radeon_save_bios_scratch_regs(rdev);
 	radeon_suspend(rdev);
 	radeon_hpd_fini(rdev);
