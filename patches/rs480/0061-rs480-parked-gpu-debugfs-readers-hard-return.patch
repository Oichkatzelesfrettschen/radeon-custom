From: radeon-custom rs480 reset-recovery track
Subject: [PATCH] drm/radeon: hard-return RS480 debugfs register readers on a parked GPU

The RS480 RE debugfs readers (rs400.c, added by the 0001-0042 series) predate
the gpu_parked flag introduced at 0046, so none of them is gated. After a
failed reset the GA-routed register bus never grants a non-posted read, so an
operator `cat` of any of these nodes issues a read that black-holes the K8
northbridge and sync-floods the box -- cold power cycle only. This is the
largest uncovered edge in the parked-state cut graph, and the only one an
operator can trigger by hand.

Add one named helper, rs480_debugfs_refuse_if_parked(), and route every RS480
RE hardware-reading debugfs path through it before any MMIO. There is no
safe/unsafe split: on a parked GPU a register reader is a diagnostic surface,
not a required runtime surface, so every hardware read hard-refuses. Read-only
seq_file nodes print one explanatory line and return success; the CP-ME inject
write node returns -EIO because the operator explicitly attempted an action
that is invalid once the GPU is parked. Two shared primitives carry the net so
a missed show cannot reach the bus: rs480_candidate_regs_emit() refuses before
its read loop, and the low-level rs480_candidate_reg_read() returns the
existing hazard sentinel instead of touching MMIO when parked. The one
pre-existing upstream reader in this file, rs400_debugfs_gart_info_show(), is
covered by the same gate.

No reset behaviour changes: on the first (unparked) read the reset/recover
probes still fire as before; the guard only refuses once gpu_parked is set.

--- a/radeon/rs400.c
+++ b/radeon/rs400.c
@@ -339,9 +339,26 @@
 }
 
 #if defined(CONFIG_DEBUG_FS)
+/* rs480_debugfs_refuse_if_parked -- after a failed RS480 reset the GA-routed
+ * register bus never grants a non-posted read, so a debugfs register read
+ * black-holes the K8 northbridge and sync-floods the box (cold cycle only).
+ * Every RS480 RE debugfs reader refuses hardware access once gpu_parked is
+ * set; the node reports the parked state instead of touching MMIO. */
+static bool rs480_debugfs_refuse_if_parked(struct seq_file *m,
+					   struct radeon_device *rdev)
+{
+	if (!rdev->gpu_parked)
+		return false;
+	seq_puts(m,
+		 "gpu parked: RS480 register read disabled to avoid non-posted MMIO black hole\n");
+	return true;
+}
+
 static int rs400_debugfs_gart_info_show(struct seq_file *m, void *unused)
 {
 	struct radeon_device *rdev = m->private;
+	if (rs480_debugfs_refuse_if_parked(m, rdev))
+		return 0;
 	uint32_t tmp;
 
 	tmp = RREG32(RADEON_HOST_PATH_CNTL);
@@ -542,6 +559,8 @@
 static int rs480_safe_regs_show(struct seq_file *m, void *unused)
 {
 	struct radeon_device *rdev = m->private;
+	if (rs480_debugfs_refuse_if_parked(m, rdev))
+		return 0;
 	unsigned int i;
 
 	for (i = 0; i < ARRAY_SIZE(rs480_safe_reg_list); i++) {
@@ -589,6 +608,8 @@
 static u32 rs480_candidate_reg_read(struct radeon_device *rdev,
 				    const struct rs480_candidate_reg *reg)
 {
+	if (rdev->gpu_parked)
+		return RS480_READ_HAZARD_SENTINEL;
 	if (rs480_offset_is_read_hazard(reg->offset))
 		return RS480_READ_HAZARD_SENTINEL;
 	if (reg->access)
@@ -650,6 +671,8 @@
 static int rs480_candidate_config_regs_show(struct seq_file *m, void *unused)
 {
 	struct radeon_device *rdev = m->private;
+	if (rs480_debugfs_refuse_if_parked(m, rdev))
+		return 0;
 	unsigned int i;
 
 	for (i = 0; i < ARRAY_SIZE(rs480_candidate_config_reg_list); i++) {
@@ -668,6 +691,8 @@
 static int rs480_candidate_gart_mc_regs_show(struct seq_file *m, void *unused)
 {
 	struct radeon_device *rdev = m->private;
+	if (rs480_debugfs_refuse_if_parked(m, rdev))
+		return 0;
 	unsigned int i;
 
 	for (i = 0; i < ARRAY_SIZE(rs480_candidate_gart_mc_reg_list); i++) {
@@ -688,6 +713,8 @@
 				     const struct rs480_candidate_reg *list,
 				     unsigned int count)
 {
+	if (rs480_debugfs_refuse_if_parked(m, rdev))
+		return 0;
 	unsigned int i;
 
 	for (i = 0; i < count; i++) {
@@ -913,6 +940,8 @@
 static int rs480_uma_status_show(struct seq_file *m, void *unused)
 {
 	struct radeon_device *rdev = m->private;
+	if (rs480_debugfs_refuse_if_parked(m, rdev))
+		return 0;
 	u32 tom = RREG32(RADEON_NB_TOM);
 	u32 base = tom & 0xffff;
 	u32 top = tom >> 16;
@@ -966,6 +995,8 @@
 static int rs480_sclk_cntl_show(struct seq_file *m, void *unused)
 {
 	struct radeon_device *rdev = m->private;
+	if (rs480_debugfs_refuse_if_parked(m, rdev))
