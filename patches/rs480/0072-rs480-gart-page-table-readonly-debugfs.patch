Subject: [PATCH] drm/radeon: expose bounded RS480 GART page-table evidence

Add a root-only, read-only debugfs view of the first 64 RS400/RS480 GART
entries.  Each row records the raw hardware PTE, the driver shadow entry,
decoded DMA address and access bits, and whether the two representations
agree.  The bounded view recovers active backing without mapping a BAR,
reading physical memory, or touching an MMIO register.

Also expose the x86 page-table cache bits for the first and last CPU pages
of the coherent GART table allocation.  These rows let a capture join the
live kernel PTE state with IA32_PAT and the driver's set_memory_uc()
source path.
The output calls decoded GART addresses DMA addresses because a physical-
address claim still requires an independently proven direct-DMA route.

The node emits at most one header, one metadata row, two CPU mapping rows,
and 64 GART rows.  It refuses unsupported, parked, and uninitialized
devices.

---
diff --git a/radeon/rs400.c b/radeon/rs400.c
--- a/radeon/rs400.c
+++ b/radeon/rs400.c
@@ -33,6 +33,10 @@
 #include <linux/pci.h>
 #include <linux/uaccess.h>
 
+#if defined(CONFIG_X86)
+#include <asm/pgtable.h>
+#endif
+
 #include <drm/drm_device.h>
 #include <drm/drm_file.h>
 
@@ -426,6 +430,124 @@
 }
 
 DEFINE_SHOW_ATTRIBUTE(rs400_debugfs_gart_info);
+
+#define RS400_GART_PAGE_TABLE_ENTRY_LIMIT 64
+
+static u64 rs400_gart_page_dma_address(u32 entry)
+{
+	return (entry & 0xfffff000ULL) | ((entry & 0x00000ff0ULL) << 28);
+}
+
+static void rs400_debugfs_gart_cpu_mapping_emit(struct seq_file *m,
+						struct radeon_device *rdev,
+						unsigned int page_index)
+{
+#if defined(CONFIG_X86)
+	unsigned long address = (unsigned long)rdev->gart.ptr +
+				page_index * PAGE_SIZE;
+	unsigned int level = 0;
+	pte_t *pte = lookup_address(address, &level);
+	u64 raw;
+
+	if (!pte) {
+		seq_printf(m,
+			   "cpu-table-map\t%u\t%u\t\t\t\t\t\t\t\t\t\t"
+			   "0x%016llx\t%u\t%u\t\t\t\t\t\t\t\tlookup-failed\n",
+			   page_index, page_index + 1,
+			   (unsigned long long)rdev->gart.table_addr,
+			   rdev->gart.table_size, rdev->gart.num_gpu_pages);
+		return;
+	}
+
+	raw = pte_val(*pte);
+	seq_printf(m,
+		   "cpu-table-map\t%u\t%u\t\t\t\t\t\t\t\t\t\t"
+		   "0x%016llx\t%u\t%u\t0x%016llx\t%u\t%u\t%u\t%u\t%u\tok\n",
+		   page_index, page_index + 1,
+		   (unsigned long long)rdev->gart.table_addr,
+		   rdev->gart.table_size, rdev->gart.num_gpu_pages,
+		   (unsigned long long)raw, level,
+		   !!(raw & _PAGE_PWT), !!(raw & _PAGE_PCD),
+		   !!(raw & _PAGE_PAT), !!(raw & _PAGE_PAT_LARGE));
+#else
+	seq_printf(m,
+		   "cpu-table-map\t%u\t%u\t\t\t\t\t\t\t\t\t\t"
+		   "0x%016llx\t%u\t%u\t\t\t\t\t\t\t\tnon-x86\n",
+		   page_index, page_index + 1,
+		   (unsigned long long)rdev->gart.table_addr,
+		   rdev->gart.table_size, rdev->gart.num_gpu_pages);
+#endif
+}
+
+static int rs400_debugfs_gart_page_table_show(struct seq_file *m, void *unused)
+{
+	struct radeon_device *rdev = m->private;
+	u32 *table = rdev->gart.ptr;
+	unsigned int entry_count;
+	unsigned int table_pages;
+	unsigned int index;
+
+	seq_puts(m,
+		 "row_type\tstart_index\tend_index_exclusive\tgpu_address\tpte_raw\t"
+		 "shadow_raw\tpage_dma_address\tunsnooped\twriteable\treadable\t"
+		 "shadow_match\ttable_dma\ttable_bytes\ttable_entries\t"
+		 "kernel_pte_raw\tkernel_pte_level\tpwt\tpcd\tpat_4k\tpat_large\tstatus\n");
+
+	if (rdev->family != CHIP_RS400 && rdev->family != CHIP_RS480) {
+		seq_puts(m, "metadata\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tunsupported-family\n");
+		return 0;
+	}
+
+	if (rdev->gpu_parked) {
+		seq_puts(m, "metadata\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tgpu-parked\n");
+		return 0;
+	}
+
+	if (!rdev->gart.ready || !table || !rdev->gart.pages_entry) {
+		seq_puts(m, "metadata\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tgart-not-ready\n");
+		return 0;
+	}
+
+	entry_count = min_t(unsigned int, rdev->gart.num_gpu_pages,
+			    RS400_GART_PAGE_TABLE_ENTRY_LIMIT);
+	table_pages = DIV_ROUND_UP(rdev->gart.table_size, PAGE_SIZE);
+	seq_printf(m,
+		   "metadata\t0\t%u\t\t\t\t\t\t\t\t\t\t0x%016llx\t%u\t%u\t"
+		   "\t\t\t\t\t\tready\n",
+		   entry_count, (unsigned long long)rdev->gart.table_addr,
+		   rdev->gart.table_size, rdev->gart.num_gpu_pages);
+
+	rs400_debugfs_gart_cpu_mapping_emit(m, rdev, 0);
+	if (table_pages > 1)
+		rs400_debugfs_gart_cpu_mapping_emit(m, rdev, table_pages - 1);
+
+	for (index = 0; index < entry_count; index++) {
+		u32 pte_raw = le32_to_cpu(READ_ONCE(table[index]));
+		u64 shadow_raw = READ_ONCE(rdev->gart.pages_entry[index]);
+
+		seq_printf(m,
+			   "gart-entry\t%u\t%u\t0x%016llx\t0x%08x\t0x%016llx\t"
+			   "0x%016llx\t%u\t%u\t%u\t%u\t0x%016llx\t%u\t%u\t"
+			   "\t\t\t\t\t\t%s\n",
+			   index, index + 1,
+			   (unsigned long long)(rdev->mc.gtt_start +
+						index * RADEON_GPU_PAGE_SIZE),
+			   pte_raw, (unsigned long long)shadow_raw,
+			   (unsigned long long)rs400_gart_page_dma_address(pte_raw),
+			   !!(pte_raw & RS400_PTE_UNSNOOPED),
+			   !!(pte_raw & RS400_PTE_WRITEABLE),
+			   !!(pte_raw & RS400_PTE_READABLE),
+			   pte_raw == lower_32_bits(shadow_raw),
+			   (unsigned long long)rdev->gart.table_addr,
+			   rdev->gart.table_size, rdev->gart.num_gpu_pages,
+			   shadow_raw == rdev->dummy_page.entry ?
+			   "dummy-backing" : "mapped-backing");
+	}
+
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(rs400_debugfs_gart_page_table);
 #endif
 
 
@@ -2976,6 +3098,8 @@
 
 	debugfs_create_file("rs400_gart_info", 0444, root, rdev,
 			    &rs400_debugfs_gart_info_fops);
+	debugfs_create_file("radeon_rs480_gart_page_table", 0400, root, rdev,
+			    &rs400_debugfs_gart_page_table_fops);
 #endif
 }
