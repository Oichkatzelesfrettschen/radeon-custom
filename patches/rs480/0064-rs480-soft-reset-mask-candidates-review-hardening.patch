From: radeon-custom rs480 reset-recovery track
Subject: [PATCH] drm/radeon: harden the RS480 soft-reset mask candidates (0063 review)

Review cleanups for 0063, no behaviour change on the default BASELINE path
except safer gating and more honest classification.

- Allow-list instead of a partial forbidden mask.  0063 rejected only the host
  bits HI/HDP/MC/AIC, but 0x0000F0 also defines VIP(10)/DISP(11)/CG(12) plus E2
  and IDCT.  A candidate may now set ONLY the 3D-domain bits VAP/RE/PP/RB/GA;
  the static_assert on each candidate rejects any other 0x0000F0 bit, so a
  future added bit cannot slip in unvetted.
- full_3d drops E2 (2D engine) and IDCT (video): neither is tied to the GA
  recovery mechanism.  It is now VAP|RE|PP|RB|GA (0x205C).
- The experimental mask is RS400/RS480-only.  Discrete R3xx/R4xx share
  r300_asic_reset and keep the stock VAP|GA baseline regardless of the param.
- One-shot arm: a non-baseline candidate is consumed on read (rs480_reset_mask
  reverts to BASELINE), so an armed mask fires exactly once and a later
  unrelated GPU reset uses the safe baseline instead of reusing GA_RB.
- The success predicate is now co-mask aware: GA and VAP clearing is not
  sufficient when GA_RB/GA_RE/full_3d also reset RB3D/RE, so the reset fails if
  RB3D_BUSY, RE_BUSY, or the master GUI_ACTIVE bit is still set -- a newly reset
  block left stuck is no longer misread as recovered.
- The candidate mask is logged with 0x%08x (was 0x%04x): a u32 mask must print
  full width because these lines are decision-grade fire evidence.

No fire. Efficacy of any candidate remains one attended fire per named mask
under separate authorization.

--- a/radeon/r300.c
+++ b/radeon/r300.c
@@ -435,15 +435,20 @@
 #define R300_RS480_SCLK_CNTL2_FORCE_3D (BIT(13) | BIT(14) | BIT(15))
 
 /* RS480 0x0000F0 soft-reset candidate masks (RAD-05j).  0043 asserts VAP|GA and
- * GA still holds; the still-open recovery space is host-safe co-masks.  Expose a
- * small bounded set of NAMED compiled masks, never a raw operator mask -- a free
- * mask is too easy to point at a host-facing bit and wedge the box.  The
- * host-facing bits HI/HDP/MC/AIC (host interface, host data path, the memory
- * controller behind the UMA framebuffer, and GART/AIC) are compile-rejected in
- * every candidate. */
-#define RS480_RESET_FORBIDDEN_MASK \
-	(S_0000F0_SOFT_RESET_HI(1) | S_0000F0_SOFT_RESET_HDP(1) | \
-	 S_0000F0_SOFT_RESET_MC(1) | S_0000F0_SOFT_RESET_AIC(1))
+ * GA still holds; the still-open recovery space is host-safe 3D co-masks.  Expose
+ * a small bounded set of NAMED compiled masks, never a raw operator mask -- a
+ * free mask is too easy to point at a host-facing bit and wedge the box.
+ *
+ * The permitted bits are an ALLOW-LIST, not a forbidden list: a candidate may set
+ * only the 3D-domain bits VAP/RE/PP/RB/GA.  Every other 0x0000F0 bit is
+ * compile-rejected -- the host bits HI/HDP/MC/AIC, the display/video/clock bits
+ * VIP/DISP/CG, the 2D engine E2, and the video IDCT -- so no candidate can reset
+ * a host, display, clock, 2D, or video block on a parked RS480.  An allow-list is
+ * safe against a future 0x0000F0 bit being added without re-vetting. */
+#define RS480_RESET_ALLOWED_MASK \
+	(S_0000F0_SOFT_RESET_VAP(1) | S_0000F0_SOFT_RESET_RE(1) | \
+	 S_0000F0_SOFT_RESET_PP(1) | S_0000F0_SOFT_RESET_RB(1) | \
+	 S_0000F0_SOFT_RESET_GA(1))
 
 #define RS480_RESET_M_BASELINE \
 	(S_0000F0_SOFT_RESET_VAP(1) | S_0000F0_SOFT_RESET_GA(1))
@@ -451,20 +456,21 @@
 	(RS480_RESET_M_BASELINE | S_0000F0_SOFT_RESET_RB(1))
 #define RS480_RESET_M_GA_RE \
 	(RS480_RESET_M_BASELINE | S_0000F0_SOFT_RESET_RE(1))
+/* full_3d drops E2 (2D engine) and IDCT (video): neither is tied to the GA
+ * recovery mechanism.  VAP/RE/PP/RB/GA is the geometry-through-backend cluster. */
 #define RS480_RESET_M_FULL_3D \
 	(S_0000F0_SOFT_RESET_VAP(1) | S_0000F0_SOFT_RESET_RE(1) | \
-	 S_0000F0_SOFT_RESET_PP(1) | S_0000F0_SOFT_RESET_E2(1) | \
-	 S_0000F0_SOFT_RESET_RB(1) | S_0000F0_SOFT_RESET_GA(1) | \
-	 S_0000F0_SOFT_RESET_IDCT(1))
-
-static_assert((RS480_RESET_M_BASELINE & RS480_RESET_FORBIDDEN_MASK) == 0,
-	      "RS480 baseline reset mask touches a host-facing bit");
-static_assert((RS480_RESET_M_GA_RB & RS480_RESET_FORBIDDEN_MASK) == 0,
-	      "RS480 ga_rb reset mask touches a host-facing bit");
-static_assert((RS480_RESET_M_GA_RE & RS480_RESET_FORBIDDEN_MASK) == 0,
-	      "RS480 ga_re reset mask touches a host-facing bit");
-static_assert((RS480_RESET_M_FULL_3D & RS480_RESET_FORBIDDEN_MASK) == 0,
-	      "RS480 full_3d reset mask touches a host-facing bit");
+	 S_0000F0_SOFT_RESET_PP(1) | S_0000F0_SOFT_RESET_RB(1) | \
+	 S_0000F0_SOFT_RESET_GA(1))
+
+static_assert((RS480_RESET_M_BASELINE & ~RS480_RESET_ALLOWED_MASK) == 0,
+	      "RS480 baseline reset mask sets a non-allowed 0x00F0 bit");
+static_assert((RS480_RESET_M_GA_RB & ~RS480_RESET_ALLOWED_MASK) == 0,
+	      "RS480 ga_rb reset mask sets a non-allowed 0x00F0 bit");
+static_assert((RS480_RESET_M_GA_RE & ~RS480_RESET_ALLOWED_MASK) == 0,
+	      "RS480 ga_re reset mask sets a non-allowed 0x00F0 bit");
+static_assert((RS480_RESET_M_FULL_3D & ~RS480_RESET_ALLOWED_MASK) == 0,
+	      "RS480 full_3d reset mask sets a non-allowed 0x00F0 bit");
 
 enum rs480_reset_mask_sel {
 	RS480_RESET_MASK_BASELINE = 0,
@@ -489,14 +495,19 @@
 MODULE_PARM_DESC(rs480_reset_mask,
 		 "RS480 0x00F0 soft-reset candidate: 0=baseline(VAP|GA) 1=ga_rb 2=ga_re 3=full_3d (invalid -> baseline)");
 
-/* Bounded selector: an out-of-range value never passes through as a mask, it
- * falls back to the conservative BASELINE (0043) candidate. */
+/* Bounded, one-shot selector: an out-of-range value never passes through as a
+ * mask, it falls back to the conservative BASELINE (0043) candidate.  A
+ * non-baseline candidate is CONSUMED on read -- rs480_reset_mask reverts to
+ * BASELINE -- so an armed experimental mask fires exactly once and a later,
+ * unrelated GPU reset uses the safe baseline rather than reusing GA_RB. */
 static u32 rs480_selected_reset_mask(const char **name_out)
 {
 	unsigned int sel = rs480_reset_mask;
 
 	if (sel >= RS480_RESET_MASK__COUNT)
 		sel = RS480_RESET_MASK_BASELINE;
+	if (sel != RS480_RESET_MASK_BASELINE)
+		rs480_reset_mask = RS480_RESET_MASK_BASELINE;
 	*name_out = rs480_reset_mask_tbl[sel].name;
 	return rs480_reset_mask_tbl[sel].mask;
 }
@@ -535,10 +546,19 @@
 	}
 	{
 		const char *rs480_mask_name;
-		u32 rs480_mask = rs480_selected_reset_mask(&rs480_mask_name);
+		u32 rs480_mask;
 
+		/* The experimental candidate masks are RS400/RS480-only.  Discrete
+		 * R3xx/R4xx share r300_asic_reset and must keep the stock VAP|GA
+		 * baseline regardless of the module param. */
+		if (igp_force_clk) {
+			rs480_mask = rs480_selected_reset_mask(&rs480_mask_name);
+		} else {
+			rs480_mask = RS480_RESET_M_BASELINE;
+			rs480_mask_name = "baseline(VAP|GA)";
+		}
 		dev_info(rdev->dev,
-			 "RS480 soft-reset candidate %s mask 0x%04x\n",
+			 "RS480 soft-reset candidate %s mask 0x%08x\n",
 			 rs480_mask_name, rs480_mask);
 		/* Posted assert; NO readback on the assert path -- the
 		 * mdelay(500) hold serializes the write before the deassert.
@@ -565,8 +585,14 @@
 	/* restore PCI & busmastering */
 	pci_restore_state(rdev->pdev);
 	r100_enable_bm(rdev);
-	/* Check if GPU is idle */
-	if (G_000E40_GA_BUSY(status) || G_000E40_VAP_BUSY(status)) {
+	/* Check if GPU is idle.  A candidate co-mask (GA_RB, GA_RE, full_3d)
+	 * also resets RB3D/RE, so GA and VAP clearing is not sufficient: a
+	 * newly reset block left stuck would otherwise be misread as recovered.
+	 * Fail the reset if any of the reset 3D blocks stays busy or the master
+	 * GUI_ACTIVE bit is still set. */
+	if (G_000E40_GA_BUSY(status) || G_000E40_VAP_BUSY(status) ||
+	    G_000E40_RB3D_BUSY(status) || G_000E40_RE_BUSY(status) ||
+	    G_000E40_GUI_ACTIVE(status)) {
 		dev_err(rdev->dev, "failed to reset GPU\n");
 		ret = -1;
 	} else
