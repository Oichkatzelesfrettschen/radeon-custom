 #define RS480_SCLK_FORCE_DISP1    (1u << 18)
 #define RS480_SCLK_FORCE_DISP2    (1u << 15)
 #define RS480_SCLK_FORCE_OV0      (1u << 31)
+#define RS480_SCLK_FORCE_TV_SCLK  (1u << 29)
 
